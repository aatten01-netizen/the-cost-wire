# Copy to .env and fill in. Never commit the real .env.
# Free key from https://www.eia.gov/opendata/register.php (needed at Step 4)
EIA_API_KEY=
# Free key from https://quickstats.nass.usda.gov/api (Step 9 cash rent + the bushels-of-corn-per-ton line)
NASS_API_KEY=
# Resend key (Step 11; test emails to Andy only)
RESEND_API_KEY=
# The ONE address test briefs are sent to (Andy). Never a subscriber list.
BRIEF_TEST_EMAIL=
# Signup form (Step 12). Both must be set for the form to go live on the site.
# Link of the Google Apps Script web app (see docs/signup-google-sheet.md)
SIGNUP_FORM_URL=
# Set to yes only when Andy approves going live
SIGNUP_LIVE=
# Optional: the site's public address, used for links in site/feed.xml (RSS).
# Leave blank to use https://aatten01-netizen.github.io/the-cost-wire/
SITE_URL=
# Pro checkout (Step 16). Both must be set for the Pricing page "Start Pro" button to work.
# A Stripe Payment Link Andy makes himself (must start with https://buy.stripe.com/)
PRO_CHECKOUT_URL=
# Set to yes only when Andy approves selling Pro (after the Pro features exist)
PRO_CHECKOUT_LIVE=
# Alert sign-up page (Step 18). Set to yes only when Andy approves taking alert sign-ups
# (uses the same SIGNUP_FORM_URL as the free signup).
ALERTS_SIGNUP_LIVE=
# Price-move alerts (Step 17). CSV OUTSIDE this repo (it holds reader emails):
# columns email,item,region,threshold. Leave blank = alerts skipped.
ALERTS_FILE=
# Optional: where already-alerted reports are remembered (default: alerts_sent.csv next to ALERTS_FILE)
ALERTS_SENT_FILE=
